DEF ciclo()
  ; Clique em IN 1 (painel E/S) para liberar cada ciclo.
  ; Ative IN 2 para encerrar após o ciclo atual.
  DECL INT ciclos
  INI
  ciclos = 0
  PTP HOME
  $OUT[1] = FALSE
  LOOP
    WAIT FOR $IN[1]
    pegar(P_A)
    soltar(P_B)
    pegar(P_B)
    soltar(P_A)
    ciclos = ciclos + 1
    $OUT[2] = TRUE           ; sinaliza ciclo concluído
    WAIT SEC 0.2
    $OUT[2] = FALSE
    IF $IN[2] THEN
      EXIT
    ENDIF
  ENDLOOP
  PTP HOME
END

DEF pegar(alvo)
  PTP alvo
  LIN_REL {Z -145}
  $OUT[1] = TRUE
  WAIT SEC 0.3
  LIN_REL {Z 145}
END

DEF soltar(alvo)
  PTP alvo
  LIN_REL {Z -140}
  $OUT[1] = FALSE
  WAIT SEC 0.3
  LIN_REL {Z 140}
END
